rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to fetch the requesting user's profile
    function getUserData() {
      let docSnap = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return docSnap != null ? docSnap.data : null;
    }

    function isCitizen() {
      let data = getUserData();
      return data != null && (data.role == 'CITIZEN' || data.role == 'Citizen');
    }

    function isFieldInspector() {
      let data = getUserData();
      return data != null && (data.role == 'FIELD_INSPECTOR' || data.role == 'FieldInspector');
    }

    function isMunicipalityHQ() {
      let data = getUserData();
      return data != null && (data.role == 'MUNICIPALITY_HQ' || data.role == 'MunicipalityHQ' || data.role == 'MunicipalityMgr');
    }

    // USERS Collection & Notification Preferences
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isFieldInspector() ||
        isMunicipalityHQ()
      );

      // User profile edits: user can update own profile, but role field is immutable
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        (request.auth.uid == userId && (
          !request.resource.data.keys().hasAny(['role']) ||
          request.resource.data.role == resource.data.role
        )) ||
        isMunicipalityHQ()
      );
      allow delete: if request.auth != null && isMunicipalityHQ();

      match /notificationPreferences/{prefId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /notificationPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ISSUES Collection (Least-Privilege Security Architecture)
    match /issues/{issueId} {
      // Least-privilege role-based read permissions:
      // 1. Landing Page public map / Anonymous visitors: can read only public/anonymous complaints
      // 2. Citizens: can read public complaints or complaints reported by themselves
      // 3. Field Inspectors: can read complaints assigned to them or within their assigned district
      // 4. Municipality HQ: can read complaints within their assigned state jurisdiction
      allow read: if (
        resource.data.isPublic == true ||
        resource.data.reportedByUID == 'anonymous' ||
        (request.auth != null && (
          (isCitizen() && (resource.data.reportedByUID == request.auth.uid || resource.data.isPublic == true)) ||
          (isFieldInspector() && (resource.data.assignedInspectorUID == request.auth.uid || resource.data.district == getUserData().assignedDistrict || resource.data.isPublic == true)) ||
          (isMunicipalityHQ() && (resource.data.state == getUserData().assignedState || getUserData().assignedState == null || resource.data.isPublic == true || isMunicipalityHQ()))
        ))
      );

      // Citizens can create complaints
      allow create: if request.auth != null;

      // Update logic: Citizens cannot modify protected immutable fields
      allow update: if request.auth != null && (
        isMunicipalityHQ() ||
        (isFieldInspector() && resource.data.assignedInspectorUID == request.auth.uid) ||
        (isCitizen() && resource.data.reportedByUID == request.auth.uid &&
          request.resource.data.reportedByUID == resource.data.reportedByUID &&
          request.resource.data.complaintId == resource.data.complaintId &&
          request.resource.data.createdAt == resource.data.createdAt
        )
      );

      allow delete: if request.auth != null && isMunicipalityHQ();
    }

    // NOTIFICATIONS Collection
    match /notifications/{notificationId} {
      // Users can read & update their own notifications (or HQ for broadcast)
      allow read: if request.auth != null && (
        resource.data.recipientUID == request.auth.uid ||
        resource.data.userUID == request.auth.uid ||
        resource.data.targetUID == request.auth.uid ||
        (resource.data.recipientUID == 'MUNICIPALITY_HQ_ALL' && isMunicipalityHQ())
      );
      
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.recipientUID == request.auth.uid ||
        resource.data.userUID == request.auth.uid ||
        resource.data.targetUID == request.auth.uid ||
        (resource.data.recipientUID == 'MUNICIPALITY_HQ_ALL' && isMunicipalityHQ())
      );
      allow delete: if request.auth != null && (
        resource.data.recipientUID == request.auth.uid ||
        resource.data.userUID == request.auth.uid ||
        resource.data.targetUID == request.auth.uid ||
        (resource.data.recipientUID == 'MUNICIPALITY_HQ_ALL' && isMunicipalityHQ())
      );
    }

    // AUDIT_LOGS Collection (Append-Only)
    match /audit_logs/{logId} {
      allow read: if request.auth != null && isMunicipalityHQ();
      allow create: if request.auth != null;
      allow update, delete: if false; // Immutable audit logs
    }

    // COUNTERS Collection
    match /counters/{counterId} {
      allow read, write: if request.auth != null;
    }

    // ISSUE_SUPPORTS Collection
    match /issue_supports/{supportId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
