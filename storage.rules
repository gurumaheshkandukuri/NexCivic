rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if path contains path traversal attempts
    function isSafePath(filename) {
      return !filename.matches('.*\\.\\..*') && !filename.matches('.*\\/.*');
    }

    // Helper function for allowed image content types
    function isAllowedImageType() {
      return request.resource.contentType == 'image/jpeg' ||
             request.resource.contentType == 'image/jpg' ||
             request.resource.contentType == 'image/png' ||
             request.resource.contentType == 'image/webp';
    }

    // Helper function for file size (max 5MB)
    function isWithinSizeLimit() {
      return request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024;
    }

    // Match issue evidence files
    match /issues/{complaintId}/{stage}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      isSafePath(filename) &&
                      isAllowedImageType() &&
                      isWithinSizeLimit();
      allow delete: if false;
    }

    // Match citizen uploads
    match /issues/{complaintId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      isSafePath(filename) &&
                      isAllowedImageType() &&
                      isWithinSizeLimit();
      allow delete: if false;
    }

    // Match profile pictures
    match /users/{userId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId &&
                      isSafePath(filename) &&
                      isAllowedImageType() &&
                      isWithinSizeLimit();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
